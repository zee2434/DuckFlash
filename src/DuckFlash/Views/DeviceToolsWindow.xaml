<Window x:Class="DuckFlash.Views.DeviceToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DuckFlash.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DeviceToolsViewModel}"
        Title="{Binding Text.DeviceTools}"
        Icon="pack://application:,,,/DuckFlash;component/Resources/Images/logo.png"
        Height="680"
        Width="860"
        MinHeight="520"
        MinWidth="720"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Padding="16,6">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Screenshot -->
                    <TextBlock Text="{Binding Text.CaptureScreenshot}"
                               Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding Text.ScreenshotScope}"
                               Style="{StaticResource HintText}" />
                    <Button Content="{Binding Text.CaptureScreenshot}"
                            Click="CaptureScreenshotButton_Click"
                            IsEnabled="{Binding CanInteract}"
                            Style="{StaticResource CompactButton}" />

                    <!-- Logcat -->
                    <TextBlock Text="{Binding Text.ExportLogcat}"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,20,0,4" />
                    <TextBlock Text="{Binding Text.LogcatScope}"
                               Style="{StaticResource HintText}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Text.ExportLogcat}"
                                Click="ExportLogcatButton_Click"
                                IsEnabled="{Binding CanInteract}"
                                Style="{StaticResource CompactButton}" />
                        <Button Content="{Binding Text.ClearLogcat}"
                                Click="ClearLogcatButton_Click"
                                IsEnabled="{Binding CanInteract}"
                                Style="{StaticResource CompactButton}"
                                Margin="0" />
                    </StackPanel>

                    <!-- Backup dan pemulihan -->
                    <TextBlock Text="{Binding Text.BackupApps}"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,20,0,4" />
                    <TextBlock Text="{Binding Text.BackupScope}"
                               Style="{StaticResource HintText}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding Text.BackupApps}"
                                Click="BackupButton_Click"
                                IsEnabled="{Binding CanInteract}"
                                Style="{StaticResource CompactButton}" />
                        <Button Content="{Binding Text.RestoreApps}"
                                Click="RestoreButton_Click"
                                IsEnabled="{Binding CanInteract}"
                                Style="{StaticResource CompactButton}"
                                Margin="0" />
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Log -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding LogEntries}"
                     FontFamily="Consolas"
                     FontSize="12"
                     VerticalContentAlignment="Top"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Formatted}"
                                   TextWrapping="NoWrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>
    </DockPanel>
</Window>

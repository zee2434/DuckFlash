<Window x:Class="DuckFlash.Views.DebloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DuckFlash.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DebloatViewModel}"
        Title="{Binding Text.Debloat}"
        Icon="pack://application:,,,/DuckFlash;component/Resources/Images/logo.png"
        Height="680"
        Width="900"
        MinHeight="520"
        MinWidth="720"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Padding="16,6">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SelectedCountText}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>

            <!-- Pencarian -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="{Binding Text.SearchPackage}"
                           Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8" />

                <CheckBox Content="{Binding Text.ShowSystemApps}"
                          IsChecked="{Binding ShowSystemApps}"
                          Margin="0,0,0,8" />
            </StackPanel>

            <!-- Tombol aksi -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="{Binding Text.LoadPackages}"
                        Command="{Binding LoadPackagesCommand}"
                        IsEnabled="{Binding CanInteract}"
                        Style="{StaticResource CompactButton}" />

                <Button Content="{Binding Text.SelectAll}"
                        Command="{Binding SelectAllCommand}"
                        Style="{StaticResource CompactButton}" />

                <Button Content="{Binding Text.ClearSelection}"
                        Command="{Binding ClearSelectionCommand}"
                        Style="{StaticResource CompactButton}" />

                <Button Content="{Binding Text.UninstallSelected}"
                        Command="{Binding UninstallSelectedCommand}"
                        Style="{StaticResource CompactButton}"
                        Margin="0" />
            </StackPanel>

            <!-- Daftar aplikasi -->
            <Grid Grid.Row="2">
                <ListBox ItemsSource="{Binding VisiblePackages}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      Content="{Binding PackageName}"
                                      Padding="0,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding Text.NoPackages}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Opacity="0.7"
                           IsHitTestVisible="False" />
            </Grid>

            <!-- Log -->
            <ListBox Grid.Row="4"
                     ItemsSource="{Binding LogEntries}"
                     FontFamily="Consolas"
                     FontSize="12"
                     VerticalContentAlignment="Top"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Formatted}"
                                   TextWrapping="NoWrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>
    </DockPanel>
</Window>

<Window x:Class="DuckFlash.Views.RemotePathPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pilih path perangkat"
        Height="520"
        Width="620"
        MinHeight="360"
        MinWidth="460"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="DescriptionText"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="UpButton"
                        DockPanel.Dock="Right"
                        Width="88"
                        Margin="8,0,0,0"
                        Click="UpButton_Click" />
                <TextBox x:Name="PathTextBox"
                         VerticalContentAlignment="Center"
                         KeyDown="PathTextBox_KeyDown" />
            </DockPanel>
            <TextBlock x:Name="ErrorText"
                       Foreground="Tomato"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="RefreshButton"
                        DockPanel.Dock="Left"
                        Width="100"
                        Margin="0,0,8,0"
                        Click="RefreshButton_Click" />
                <Button x:Name="CurrentFolderButton"
                        Click="CurrentFolderButton_Click" />
            </DockPanel>
            <DockPanel>
                <Button x:Name="CancelButton"
                        DockPanel.Dock="Right"
                        Width="100"
                        Margin="8,0,0,0"
                        IsCancel="True" />
                <Button x:Name="SelectButton"
                        Click="SelectButton_Click" />
            </DockPanel>
        </StackPanel>

        <ListBox x:Name="EntriesListBox"
             SelectionMode="Extended"
             SelectionChanged="EntriesListBox_SelectionChanged"
                 MouseDoubleClick="EntriesListBox_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"
                               Padding="4,3" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>

<Window x:Class="DuckFlash.Services.DestructiveDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konfirmasi Aksi"
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Judul -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <!-- Peringatan besar -->
        <Border Grid.Row="1"
                Background="#FFF3E0"
                BorderBrush="#E65100"
                BorderThickness="2"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
            <TextBlock Text="{Binding WarningText}"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Foreground="#B71C1C"
                       Opacity="1" />
        </Border>

        <!-- Isi pesan -->
        <TextBlock Grid.Row="2"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   Opacity="0.9"
                   Margin="0,0,0,12" />

        <!-- Centang konfirmasi -->
        <CheckBox Grid.Row="3"
                  x:Name="AcknowledgementCheckBox"
                  Content="{Binding AcknowledgmentLabel}"
                  IsChecked="{Binding AcknowledgementChecked}"
                  Margin="0,0,0,16" />

        <!-- Tombol -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Batal"
                    Width="90"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancel" />
            <Button x:Name="ConfirmButton"
                    Content="Ya, lanjutkan"
                    Width="130"
                    IsDefault="True"
                    Click="OnConfirm" />
        </StackPanel>
    </Grid>
</Window>
